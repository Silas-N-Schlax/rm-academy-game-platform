footer.game-hand
  = simple_form_for @game.turn_class.new(game: @game, user: current_user), url: game_turns_path(@game), method: :post, html: { id: "hand-actions-form", class: "game-hand__form" } do |f|
    .game-hand__main
      p.game-hand__label = "Your Hand"
      .card-collection.card-collection--large
        - presenter.hand.each do |card|
          - card_id = "hand-card-#{card[:rank]}-#{card[:suit]}"
          label.game-hand__card for="#{card_id}" data-testid="hand-card"
            input type="checkbox" name="turn[card_ids][]" value="#{card[:rank]}:#{card[:suit]}" id="#{card_id}" class="game-hand__card-input" data-game-board-selection-target="handCheckbox" data-action="change->game-board-selection#syncSelectionState"
            = image_tag "cards/#{card[:card]}.svg", class: "playing-card playing-card--large"

    input type="hidden" data-game-board-selection-target="layoffActionField"
    input type="hidden" data-game-board-selection-target="layoffMeldIndexField"

    .game-hand__actions
      .game-hand__action-grid
        button.btn.btn--primary type="submit" name="turn[action]" value="meld" disabled=presenter.awaiting_draw data-game-board-selection-target="meldAction" title=(presenter.awaiting_draw ? "Draw a card first" : nil)
          | Meld
        button.btn type="submit" name="turn[action]" value="discard" disabled=presenter.awaiting_draw data-game-board-selection-target="discardAction" title=(presenter.awaiting_draw ? "Draw a card first" : nil)
          | Discard
        button.btn type="button"
          | Sort
          i.li.li-arrow-up-down.icon.icon--small
        button.btn type="button" data-action="click->game-board-selection#clearSelection"
          | Clear
          i.li.li-x.icon.icon--small
