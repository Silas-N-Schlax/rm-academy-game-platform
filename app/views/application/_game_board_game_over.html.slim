dialog.modal#game-over-modal data-testid="game-over-modal" closedby="any" data-controller=("dialog" if presenter.winner_name.present?)
  .modal__body.game-result
    div.game-result__trophy
      i.li.li-trophy.icon.icon--x-large
    p.game-result__winner = "#{presenter.winner_name} wins!"
    p.game-result__subtitle Ranked by pip total left in hand, lowest first
    ul.game-result__ranking
      - presenter.ranking.each do |entry|
        li
          span = "#{entry[:place]}. #{entry[:name]} #{entry[:flag]}"
          span = "#{entry[:pips]} pips"
    button.btn.btn--primary.game-result__close type="button" commandfor="game-over-modal" command="close"
      | Close
