- filters = leaderboard_filters(wins_bounds: wins_bounds, games_bounds: games_bounds)

.page data-controller="slide-drawer"
  .leaderboard__controls
    = render 'leaderboard_sort', search: search, per_page: per_page
    button.btn.btn--icon.leaderboard__filter-trigger type="button" aria-label="Filters" data-testid="leaderboard-filter-trigger" data-action="click->slide-drawer#open"
      i.li.li-sliders-horizontal.icon
      - if filters.any?
        span.leaderboard__filter-badge data-testid="leaderboard-filter-badge" = filters.size

  - if filters.any?
    .leaderboard__filter-chips
      - filters.each do |filter|
        span.leaderboard__filter-chip data-testid="leaderboard-filter-chip-#{filter[:column]}"
          = filter[:label]
          a.leaderboard__filter-chip-remove href=filter[:remove_url] data-testid="leaderboard-filter-chip-#{filter[:column]}-remove" aria-label="Remove #{filter[:label]} filter"
            | ×

  header.content-header
    .content-header__details
      .content-header__title Leaderboard
    p.leaderboard-standing
      | You're
      strong = " ##{your_rank} "
      | of
      strong = " #{@rows.total_count} "
      | players
    .divider.divider--medium

  .page__content
    table.table.table--fixed-layout.table--sticky-header.leaderboard
      colgroup
        col.leaderboard__col-rank
        col
        col.leaderboard__col-stat
        col.leaderboard__col-stat
        col.leaderboard__col-stat.leaderboard__col-stat--ratio
        col.leaderboard__col-stat.leaderboard__col-stat--time
      = render 'leaderboard_head'
      tbody
        - @rows.each do |row|
          = render 'leaderboard_row', row: row
    = render 'application/pager', url: leaderboard_index_path, per_page: per_page, per_page_options: Leaderboard::PER_PAGE_OPTIONS, hidden_params: leaderboard_hidden_pager_params, collection: @rows

  = render 'leaderboard_filter_drawer', per_page: per_page, wins_bounds: wins_bounds, games_bounds: games_bounds, country_options: country_options
