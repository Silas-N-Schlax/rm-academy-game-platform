= turbo_stream_from @game

.alert-banner.alert.alert--danger.alert--muted data-testid="offline-banner" data-controller="offline" data-offline-target="offlineBanner"
  i.li.li-globe-off.icon.alert__icon
  .alert__messages
    .alert__title Offline
    .alert__description You are offline, reconnect to keep playing

- if @game.game_state.nil?
  = render partial: "waiting_screen", locals: { game: @game }
- else
  - presenter = @game.presenter_class.new(@game, current_user, turn: local_assigns[:turn], turn_timer_seconds: Rails.application.config.x.turn_timer_seconds)
  = render partial: @game, locals: { presenter: presenter }
