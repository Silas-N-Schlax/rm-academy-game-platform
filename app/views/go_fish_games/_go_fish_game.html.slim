.game-board data-controller="card-select gofish-turn slide-drawer"
  = render "board_topbar", presenter: presenter

  .game-table
    .game-table__seats
      - presenter.opponents.each do |player|
        = render "game_table_player", player: player
    .game-table__center

  = simple_form_for @game.turn_class.new(game: @game, user: current_user), url: game_turns_path(@game), method: :post, html: { id: "ask-form" } do |f|
    input type="hidden" name="turn[player]" data-gofish-turn-target="playerField"
    input type="hidden" name="turn[rank]" data-card-select-target="rankField"

  footer.game-hand
    .game-hand__main
      p.game-hand__label = "Your Hand"
      .card-collection.card-collection--large
        - presenter.hand.each do |card|
          - card_id = "hand-card-#{card[:rank]}-#{card[:suit]}"
          label.game-hand__card for="#{card_id}"
            input type="radio" name="hand-card-select" id="#{card_id}" disabled=presenter.hand_disabled data-testid="hand-card" data-card-select-target="card" data-rank="#{card[:rank]}" data-suit="#{card[:suit]}" data-action="change->card-select#choose"
            = image_tag "cards/#{card[:card]}.svg", class: "playing-card playing-card--large", data: { testid: "hand-card-image" }
      - if presenter.your_books.any?
        p.game-hand__label data-testid="your-books-label" = "Your Books"
        = render "card_collection", hand: presenter.your_books, modifier: "--medium", back: false, testid: "your-book-card"

  - presenter.opponents.each do |player|
    = render "game_table_player_dialog", player: player

  = render "game_board_feed", presenter: presenter
  = render "game_board_game_over", presenter: presenter
  = render "action_notice", presenter: presenter
